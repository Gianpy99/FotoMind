# Copy to ~/apps/fotomind/.env on the Pi (chmod 600). Used by scripts/pi-check.ps1 for the
# dev container (fotomind-dev) and the integration tests. Never the production database.
# Docker containers reach the host Postgres via the LAN address (pg_hba allows 172.16.0.0/12).
DATABASE_URL=postgres://fotomind_dev:<password>@192.168.1.129:5432/fotomind_dev
FOTOMIND_TEST_DATABASE_URL=postgres://fotomind_dev:<password>@192.168.1.129:5432/fotomind_test
