# Copy to .env for local development (never commit .env).
# In production these come from the Jenkinsfile; DATABASE_URL from the Jenkins credential
# "fotomind-database-url" (created by the portal admin).
# No Docker on the PC: the dev/test databases live on the Pi's PostgreSQL 15
# (deployment/raspberry-pi/create-dev-databases.sql, role fotomind_dev).

# ---- API (runs on the Pi in production) --------------------------------------
# development | test | production (production requires the Remote-User header from Caddy)
APP_ENV=development
HOST=127.0.0.1
PORT=8000
# Leave empty to run the API without a database. Never point this at the production DB.
DATABASE_URL=postgres://fotomind_dev:<password>@192.168.1.129:5432/fotomind_dev
RUN_MIGRATIONS_ON_STARTUP=true
DATA_DIR=./.data
# Pretend to be this portal user locally (ignored in production)
DEV_USER=dev
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console

# Integration tests only (migrations are downgraded there). Never the production DB.
FOTOMIND_TEST_DATABASE_URL=postgres://fotomind_dev:<password>@192.168.1.129:5432/fotomind_test

# ---- Worker (runs on the Windows PC) -----------------------------------------
# Local: http://localhost:8000   Production: https://photos.borrellofamily.co.uk
FOTOMIND_API_URL=http://localhost:8000
# Portal login (Caddy basic auth today). Leave empty for local development.
FOTOMIND_API_USER=
FOTOMIND_API_PASSWORD=
FOTOMIND_CACHE_DIR=./.data/worker-cache
