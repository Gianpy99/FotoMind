{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FotoMind",
  "version": "0.1.0",
  "identifier": "uk.co.borrellofamily.fotomind",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FotoMind",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://127.0.0.1:8000 https://photos.borrellofamily.co.uk https://tile.openstreetmap.org; connect-src 'self' http://127.0.0.1:8000 https://photos.borrellofamily.co.uk; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
